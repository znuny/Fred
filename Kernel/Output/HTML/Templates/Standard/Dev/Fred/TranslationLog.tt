<div class="FredBox">
    <h1>
        [% Translate("Translation Log - Missing Translations") | html %]
        <span class="FredToolBar">
            <i class="fa fa-minus FredMinimize" title="Minimize"></i>
            <i class="fa fa-times FredClose" title="Close"></i>
        </span>
    </h1>
    <div id="FredTranslationLog" class="FredBoxContent FredElementList">
        [% Data.HTMLLines %]
    </div>
</div>