<div class="FredBox">
    <h1>
        [% Translate("HTML Check") | html %]
        <span class="FredToolBar">
            <i class="fa fa-minus FredMinimize" title="Minimize"></i>
            <i class="fa fa-times FredClose" title="Close"></i>
        </span>
    </h1>
    <div id="FredHTMLCheckResults" class="FredBoxContent">
        <div id="FredHTMLCheckRunning">
            <i class="fa fa-spinner fa fa-spin"></i>&nbsp; Checks are running...
        </div>
    </div>
</div>
