<?xml version="1.0" encoding="utf-8" ?>
<otrs_config version="2.0" init="Application">
    <!-- nofilter(TidyAll::Plugin::Znuny::XML::Configuration::Navigation) -->
    <!-- nofilter(TidyAll::Plugin::Znuny::Config::ACLKeysLevel3Actions) -->
    <Setting Name="Fred###Active" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Defines if Fred is visible or hidden.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="Select" SelectedID="1">
                <Item ValueType="Option" Value="1" Translatable="1">Yes</Item>
                <Item ValueType="Option" Value="0" Translatable="1">No</Item>
            </Item>
        </Value>
    </Setting>
    <Setting Name="Fred###LogPath" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Defines the log path for Freds logs.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="">/var/log/dev/fred/</Item>
        </Value>
    </Setting>
    <Setting Name="Fred###SystemName" Required="1" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Customizable system name. If empty, config item 'Home' is being used for display.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex=""></Item>
        </Value>
    </Setting>
    <Setting Name="Fred###BackgroundColor" Required="1" Valid="1" ConfigLevel="100">
        <Description Translatable="1">This option defines the background color for the sytem name box.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="">#FF8A25</Item>
        </Value>
    </Setting>
    <Setting Name="Fred###ConsoleWidth" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Defines the width of the Fred console in percent.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="">30%</Item>
        </Value>
    </Setting>
    <Setting Name="Fred###ConsoleHeight" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Defines the height of the Fred console in pixel.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="">200px</Item>
        </Value>
    </Setting>
    <Setting Name="Fred###ConsoleOpacity" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Defines the opacity of the Fred console, e.g. 0.9 for 10% transparency.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="">0.9</Item>
        </Value>
    </Setting>
    <Setting Name="Fred###Module###Console" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Turn on if you want to use the Fred console.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Active">1</Item>
                <Item Key="Prio">99999</Item>
                <Item Key="Description">Shows a short list of all needed developer information.</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Fred###Module###ConfigSwitch" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Turn on if you want to use the config switch mechanism.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Active">1</Item>
                <Item Key="Prio">1000</Item>
                <Item Key="Description">Switch on or off some often needed config items directly in Fred. List of config settings which should be available for quick switch. Please add only settings with possible values 0 or 1 (No/Yes).</Item>
                <Item Key="Config">
                    <Hash>
                        <Item Key="Settings">
                            <Array>
                                <Item>Frontend::RichText</Item>
                                <Item>Frontend::DebugMode</Item>
                                <Item>Frontend::TemplateCache</Item>
                                <Item>Frontend::MenuDragDropEnabled</Item>
                                <Item>TicketACL::Debug::Enabled</Item>
                                <Item>Ticket::Frontend::NeedSpellCheck</Item>
                                <Item>Ticket::Responsible</Item>
                                <Item>Ticket::Type</Item>
                                <Item>Ticket::Service</Item>
                                <Item>Ticket::Watcher</Item>
                                <Item>Ticket::UseArticleColors</Item>
                                <Item>CheckMXRecord</Item>
                                <Item>CheckEmailAddresses</Item>
                                <Item>SessionUseCookie</Item>
                                <Item>Loader::Enabled::CSS</Item>
                                <Item>Loader::Enabled::JS</Item>
                                <Item>OpenMainMenuOnHover</Item>
                                <Item>SecureMode</Item>
                            </Array>
                        </Item>
                    </Hash>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Fred###Module###EnvLog" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Turn on if you want to see the data in the environment of the layout object.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Active">1</Item>
                <Item Key="Prio">2000</Item>
                <Item Key="Description">Logs out all environment variables.</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Fred###Module###SessionLog" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Turn on if you want to see the data in the server side session object.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Active">1</Item>
                <Item Key="Prio">3000</Item>
                <Item Key="Description">Logs out all session variables.</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Fred###Module###STDERRLog" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Turn on if you want to see the STDERRLog.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Active">1</Item>
                <Item Key="Prio">4000</Item>
                <Item Key="Description">Lists entries from the STDERR log.</Item>
                <Item Key="Config">
                    <Hash>
                        <Item Key="Filter" ValueType="String" ValueRegex="">: [ ] Subroutine [ ] [_a-zA-Z0-9]+ [ ] redefined [ ] at [ ] .+ [ ] line [ ] \d+ \.</Item>
                    </Hash>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Fred###Module###ConfigLog" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Turn on if you want to use the config log mechanism.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Active">1</Item>
                <Item Key="Prio">5000</Item>
                <Item Key="Description">Lists all configuration items which were used in this call (and how often they were called).</Item>
                <Item Key="Config">
                    <Hash>
                        <Item Key="OrderBy" ValueType="Select" SelectedID='3'>
                            <Item ValueType="Option" Value="3">Calls</Item>
                            <Item ValueType="Option" Value="0">Config</Item>
                            <Item ValueType="Option" Value="2">Package</Item>
                        </Item>
                    </Hash>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Fred###Module###SQLLog" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Turn on if you want an real-time SQL statement log function.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Active">1</Item>
                <Item Key="Prio">6000</Item>
                <Item Key="Description">Shows a list of all SQL statements executed in this call.</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Fred###Module###HTMLCheck" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Turn on if you want an real-time HTML-checker.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Active">1</Item>
                <Item Key="Prio">7000</Item>
                <Item Key="Description">Validates the HTML in this call.</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Fred###Module###TranslationLog" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Turn on if you want the translation debugger.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Active">1</Item>
                <Item Key="Prio">9000</Item>
                <Item Key="Description">Shows a list of untranslated strings. Please note that strings from framework AND custom modules will be shown.</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Frontend::Module###Fred" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Frontend module registration for the Fred object in the admin area.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="FrontendRegistration">
                <Hash>
                    <Item Key="Group">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="GroupRo">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="Description">Dev</Item>
                    <Item Key="Title">Fred-Developertools</Item>
                    <Item Key="NavBarName">Dev</Item>
                </Hash>
            </Item>
        </Value>
    </Setting>
    <Setting Name="CustomerFrontend::Module###Fred" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Frontend module registration for the customer interface.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="FrontendRegistration">
                <Hash>
                    <Item Key="Group">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="GroupRo">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="Description">Dev</Item>
                    <Item Key="Title">Fred-Developertools</Item>
                    <Item Key="NavBarName">Dev</Item>
                </Hash>
            </Item>
        </Value>
    </Setting>
    <Setting Name="PublicFrontend::Module###Fred" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Frontend module registration for the public interface.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Item ValueType="FrontendRegistration">
                <Hash>
                    <Item Key="Group">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="GroupRo">
                        <Array>
                        </Array>
                    </Item>
                    <Item Key="Description">Dev</Item>
                    <Item Key="Title">Fred-Developertools</Item>
                    <Item Key="NavBarName">Dev</Item>
                </Hash>
            </Item>
        </Value>
    </Setting>
    <Setting Name="Frontend::Output::FilterContent###Fred" Required="0" Valid="1" ConfigLevel="100">
        <Description Translatable="1">Subscribe the output filter at the system.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Hash>
                <Item Key="Module">Kernel::Output::HTML::FilterContent::Dev::Fred</Item>
                <Item Key="Debug">0</Item>
                <Item Key="Templates">
                    <Hash>
                        <Item Key="ALL">1</Item>
                    </Hash>
                </Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Loader::Agent::CommonJS###999-Fred" Required="1" Valid="1" ConfigLevel="100">
        <Description Translatable="1">List of JS files to always be loaded for the agent interface.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Array>
                <Item>Core.Dev.Fred.js</Item>
                <Item>Core.Dev.Fred.ConfigSwitch.js</Item>
                <Item>Core.Dev.Fred.HTMLCheck.js</Item>
                <Item>Core.Dev.Fred.SQLLog.js</Item>
            </Array>
        </Value>
    </Setting>
    <Setting Name="Loader::Customer::CommonJS###999-Fred" Required="1" Valid="1" ConfigLevel="100">
        <Description Translatable="1">List of JS files to always be loaded for the customer interface.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Array>
                <Item>Core.Dev.Fred.js</Item>
                <Item>Core.Dev.Fred.ConfigSwitch.js</Item>
                <Item>Core.Dev.Fred.HTMLCheck.js</Item>
                <Item>Core.Dev.Fred.SQLLog.js</Item>
            </Array>
        </Value>
    </Setting>
    <Setting Name="Loader::Agent::CommonCSS###999-Fred" Required="1" Valid="1" ConfigLevel="100">
        <Description Translatable="1">List of CSS files to always be loaded for the agent interface.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Array>
                <Item>Core.Dev.Fred.css</Item>
            </Array>
        </Value>
    </Setting>
    <Setting Name="Loader::Customer::CommonCSS###999-Fred" Required="1" Valid="1" ConfigLevel="100">
        <Description Translatable="1">List of CSS files to always be loaded for the customer interface.</Description>
        <Navigation>Dev::Fred</Navigation>
        <Value>
            <Array>
                <Item>Core.Dev.Fred.css</Item>
            </Array>
        </Value>
    </Setting>
</otrs_config>
